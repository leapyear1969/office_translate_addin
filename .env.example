CLIENT_ID=59a13c0d-6f19-4c66-b8fd-2fa80d0186bc
CLIENT_SECRET=
SSO_RESOURCE=api://localhost:3000/59a13c0d-6f19-4c66-b8fd-2fa80d0186bc
AUTHORITY=https://login.partner.microsoftonline.cn
GRAPH_BASE=https://microsoftgraph.chinacloudapi.cn
TRANSLATOR_ENDPOINT=https://api.translator.azure.cn/
TRANSLATOR_KEY=
TRANSLATOR_REGION=
# Production: NODE_ENV=production behind a TLS reverse proxy, or set both certificate paths.
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# PostgreSQL statistics database. Use a dedicated database/application role; never commit this URL.
ANALYTICS_DATABASE_URL=
# Defaults to CLIENT_ID, reusing the existing Entra app. Register APP_BASE_URL/admin/usage as an exact SPA redirect URI.
ADMIN_CLIENT_ID=
ADMIN_LOGIN_TENANT=organizations
# JSON array: [{"tenant_id":"<admin tenant GUID>","user_oid":"<admin object GUID>","tenants":["<allowed tenant GUID>"]}]
# Alternatively use "email" instead of "user_oid"; server verifies Graph /me identity and mail, never frontend email.
# Set "tenants":["*"] for a designated administrator to view all current and future tenants.
# Empty by default: no user has read access. This does not disable statistics collection.
ANALYTICS_ADMINS=[]
