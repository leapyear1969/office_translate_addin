APP_BASE_URL=https://localhost:3000
PORT=3000
TENANT_ID=d7125684-0e28-40b5-aba2-ea9580f2a201
CLIENT_ID=59a13c0d-6f19-4c66-b8fd-2fa80d0186bc
CLIENT_SECRET=
SSO_RESOURCE=api://localhost:3000/59a13c0d-6f19-4c66-b8fd-2fa80d0186bc
AUTHORITY=https://login.partner.microsoftonline.cn
GRAPH_BASE=https://microsoftgraph.chinacloudapi.cn
TRANSLATOR_ENDPOINT=https://api.translator.azure.cn/
TRANSLATOR_KEY=
TRANSLATOR_REGION=
# Prefer the LAN FastAPI + Argos service. Set an empty endpoint to use Azure only.
LOCAL_TRANSLATOR_ENDPOINT=http://192.168.3.101:30261
# Fall back to Azure on unsupported languages/errors when TRANSLATOR_KEY is set.
LOCAL_TRANSLATOR_FALLBACK=true
# Production: NODE_ENV=production behind a TLS reverse proxy, or set both certificate paths.
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# PostgreSQL statistics database. Use a dedicated database/application role; never commit this URL.
ANALYTICS_DATABASE_URL=
# Daily usage retention in calendar months (1-1200); 0 keeps data forever; default 12. Restart the server after changing.
ANALYTICS_RETENTION_MONTHS=12
# Defaults to CLIENT_ID, reusing the existing Entra app. Register APP_BASE_URL/admin/usage as an exact SPA redirect URI.
ADMIN_CLIENT_ID=
ADMIN_LOGIN_TENANT=organizations
# JSON array: [{"tenant_id":"<admin tenant GUID>","user_oid":"<admin object GUID>","tenants":["<allowed tenant GUID>"]}]
# Authorization requires tenant_id + user_oid. Legacy email-only entries are inactive and need manual migration.
# Set "tenants":["*"] for a designated administrator to view all current and future tenants.
# Bootstrap only: imported into PostgreSQL once. Afterwards manage access at /admin/settings.
# Imported all-tenant admins can manage admins by default; set "can_manage_admins":false to keep one read-only.
# For a scoped bootstrap manager, explicitly set "can_manage_admins":true.
# Empty by default: no user has read access. Initialize at least one manager before first use.
ANALYTICS_ADMINS=[]
