{
  "name": "outlook-mail-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Outlook in-place mail translation with Azure China Translator and Office SSO",
  "scripts": {
    "build": "node scripts/generate-manifest.js && webpack --mode production",
    "dev-server": "node scripts/generate-manifest.js && webpack serve --mode development",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "start": "node server/start.js",
    "manifest:generate": "node scripts/generate-manifest.js"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/office-js-preview": "1.0.728",
    "copy-webpack-plugin": "14.0.0",
    "html-webpack-plugin": "5.6.8",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "office-addin-dev-certs": "2.0.10",
    "office-addin-manifest": "1.13.6",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "5.9.2",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.2"
  },
  "engines": {
    "node": ">=20.16"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.10",
    "cheerio": "1.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "jose": "^5.10.0"
  }
}
